# Copy to .env and fill in. .env is git-ignored.

# CoinDCX API (a read-only key is sufficient for paper mode)
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Runtime
MATS_MODE=paper            # paper | live
MATS_ALLOW_LIVE=0          # must be 1 (and MATS_MODE=live) to place real orders
MATS_LOG_LEVEL=INFO

# Paper account
MATS_PAPER_START_CAPITAL_INR=1300
